# No API key needed: the eval scripts use your Claude Code plan login.
# Do NOT set ANTHROPIC_API_KEY. The scripts unset it so nothing gets billed.
MODEL=sonnet
EFFORT=medium
# Per-call runaway guard (a list-price estimate, not billing)
MAX_BUDGET_USD=1
# Required to run anything: cap on the SUMMED total_cost_usd of all results (list-price estimate). Set it from PLAN.md.
# CUM_COST_CAP_USD=
